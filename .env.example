# Required Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Required LLM provider settings
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1

# PostgreSQL connection settings (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finbot
POSTGRES_USER=finbot
POSTGRES_PASSWORD=

# Required for Google Sheets export (V2)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/service_account.json
